{
  "name": "contentdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:create": "createdb -h localhost -p 55432 -U contentdesk contentdesk",
    "db:migrate": "psql -h localhost -p 55432 -U contentdesk -d contentdesk -f migrations/001_init.sql",
    "db:start": "pg_ctl -D .postgres-data -o \"-p 55432\" -l .postgres-data/postgres.log start",
    "db:status": "pg_ctl -D .postgres-data status",
    "db:stop": "pg_ctl -D .postgres-data stop",
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "prompt:select": "tsx scripts/prompt-select.ts",
    "prompt:scan": "tsx scripts/prompt-scan.ts",
    "prompt:scan:selected": "tsx scripts/prompt-scan.ts data/tiny-lemon-prompts.selected.json",
    "slack:start": "tsx src/slack/app.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.0",
    "@slack/web-api": "^7.8.0",
    "@trigger.dev/sdk": "^4.0.0",
    "@vercel/blob": "^2.4.0",
    "ai": "^6.0.191",
    "dotenv": "^16.5.0",
    "next": "^15.3.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@slack/cli-hooks": "^1.3.2",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.0",
    "trigger.dev": "^4.4.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
