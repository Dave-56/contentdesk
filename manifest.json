{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "ContentDesk"
  },
  "features": {
    "bot_user": {
      "display_name": "ContentDesk",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/contentdesk",
        "description": "Start a ContentDesk content cycle",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "commands"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "is_hosted": false,
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
